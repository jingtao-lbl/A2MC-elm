# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Environment
.env
*.key
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Memory data (only development logs are ignored)
memory/logs/

# Site-specific data (except Kougarok reference example)
use_cases/*/memory/
!use_cases/ELM-FATES_Kougarok/memory/
use_cases/ELM-FATES_Kougarok/memory/extracted/
!use_cases/ELM-FATES_Kougarok/memory/gained_knowledge/
!use_cases/ELM-FATES_Kougarok/memory/workflow_*.json

# Jupyter checkpoints
.ipynb_checkpoints/
use_cases/*/config/*_config.sh
!use_cases/ELM-FATES_Kougarok/config/
!use_cases/TEMPLATE/
# The two negations above end in "/", and a trailing-slash pattern matches DIRECTORIES ONLY --
# so neither ever re-included the *_config.sh FILES excluded by the line above them. Effect:
# rsync copied kougarok_config.sh and template_config.sh into the public clone, `git add -A`
# silently skipped them as ignored, and they never reached GitHub. The public repo shipped a
# config/ directory with its site config missing -- for BOTH the worked reference and the
# TEMPLATE that user_guide.md 2.1 tells new users to copy. Confirmed 2026-08-21 with
# `git check-ignore -v`, which named line 40 as the matching rule. File-level negations:
!use_cases/ELM-FATES_Kougarok/config/*_config.sh
!use_cases/TEMPLATE/config/*_config.sh
*.bak

# Large data files
*.nc
*.h5
*.tar.gz
