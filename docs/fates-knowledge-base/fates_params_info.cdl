    double fates_allom_cmode(fates_pft=12);
      :units = "index";
      :long_name = "coarse root biomass allometry function index.";

    double fates_allom_crown_depth_frac(fates_pft=12);
      :units = "fraction";
      :long_name = "the depth of a cohort crown as a fraction of its height";

    double fates_allom_d2bl1(fates_pft=12);
      :units = "variable";
      :long_name = "Parameter 1 for d2bl allometry";

    double fates_allom_d2bl2(fates_pft=12);
      :units = "variable";
      :long_name = "Parameter 2 for d2bl allometry";

    double fates_allom_d2bl3(fates_pft=12);
      :units = "unitless";
      :long_name = "Parameter 3 for d2bl allometry";

    double fates_allom_d2ca_coefficient_max(fates_pft=12);
      :units = "m2 cm^(-1/beta)";
      :long_name = "max (savanna) dbh to area multiplier factor where: area = n*d2ca_coeff*dbh^beta";

    double fates_allom_d2ca_coefficient_min(fates_pft=12);
