      :long_name = "min (forest) dbh to area multiplier factor where: area = n*d2ca_coeff*dbh^beta";

    double fates_allom_d2h1(fates_pft=12);
      :units = "variable";
      :long_name = "Parameter 1 for d2h allometry (intercept, or c)";

    double fates_allom_d2h2(fates_pft=12);
      :units = "variable";
      :long_name = "Parameter 2 for d2h allometry (slope, or m)";

    double fates_allom_d2h3(fates_pft=12);
      :units = "variable";
      :long_name = "Parameter 3 for d2h allometry (optional)";

    double fates_allom_dbh_maxheight(fates_pft=12);
      :units = "cm";
      :long_name = "the diameter (if any) corresponding to maximum height, diameters may increase beyond this";

    double fates_allom_fmode(fates_pft=12);
      :units = "index";
      :long_name = "fine root biomass allometry function index.";

    double fates_allom_fnrt_prof_a(fates_pft=12);
      :units = "unitless";
      :long_name = "Fine root profile function, parameter a";

    double fates_allom_fnrt_prof_b(fates_pft=12);
      :units = "unitless";
      :long_name = "Fine root profile function, parameter b";

    double fates_allom_fnrt_prof_mode(fates_pft=12);
      :units = "index";
      :long_name = "Index to select fine root profile function: 1) Jackson Beta, 2) 1-param exponential 3) 2-param exponential";

    double fates_allom_frbstor_repro(fates_pft=12);
      :units = "fraction";
      :long_name = "fraction of bstore goes to reproduction after plant dies";

    double fates_allom_hmode(fates_pft=12);
      :units = "index";
      :long_name = "height allometry function index.";

    double fates_allom_l2fr(fates_pft=12);
      :units = "gC/gC";
      :long_name = "Allocation parameter: fine root C per leaf C";

    double fates_allom_la_per_sa_int(fates_pft=12);
