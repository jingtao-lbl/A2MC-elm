    double fates_phen_ncolddayslim;
      :units = "days";
      :long_name = "day threshold exceedance for temperature leaf-drop";

    double fates_q10_froz;
      :units = "unitless";
      :long_name = "Q10 for frozen-soil respiration rates";

    double fates_q10_mr;
      :units = "unitless";
