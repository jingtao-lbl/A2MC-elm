      :long_name = "residual water conent";

    double fates_hydro_rfrac_stem(fates_pft=12);
      :units = "fraction";
      :long_name = "fraction of total tree resistance from troot to canopy";

    double fates_hydro_rs2(fates_pft=12);
      :units = "m";
      :long_name = "absorbing root radius";

    double fates_hydro_srl(fates_pft=12);
