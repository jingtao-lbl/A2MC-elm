    double fates_allom_lmode(fates_pft=12);
      :units = "index";
      :long_name = "leaf biomass allometry function index.";

    double fates_allom_sai_scaler(fates_pft=12);
      :units = "m2/m2";
      :long_name = "allometric ratio of SAI per LAI";

    double fates_allom_smode(fates_pft=12);
      :units = "index";
      :long_name = "sapwood allometry function index.";

    double fates_allom_stmode(fates_pft=12);
      :units = "index";
      :long_name = "storage allometry function index: 1) Storage proportional to leaf biomass (with trimming), 2) Storage proportional to maximum leaf biomass (not trimmed)";

    double fates_allom_zroot_k(fates_pft=12);
      :units = "unitless";
      :long_name = "scale coefficient of logistic rooting depth model";

    double fates_allom_zroot_max_dbh(fates_pft=12);
      :units = "cm";
      :long_name = "dbh at which a plant reaches the maximum value for its maximum rooting depth";

    double fates_allom_zroot_max_z(fates_pft=12);
      :units = "m";
      :long_name = "the maximum rooting depth defined at dbh = fates_allom_zroot_max_dbh. note: max_z=min_z=large, sets rooting depth to soil depth";

    double fates_allom_zroot_min_dbh(fates_pft=12);
      :units = "cm";
      :long_name = "dbh at which the maximum rooting depth for a recruit is defined";

    double fates_allom_zroot_min_z(fates_pft=12);
      :units = "m";
      :long_name = "the maximum rooting depth defined at dbh = fates_allom_zroot_min_dbh. note: max_z=min_z=large, sets rooting depth to soil depth";

    double fates_c2b(fates_pft=12);
      :units = "ratio";
      :long_name = "Carbon to biomass multiplier of bulk structural tissues";

    double fates_cnp_eca_alpha_ptase(fates_pft=12);
      :units = "g/m3";
      :long_name = "fraction of P from ptase activity sent directly to plant (ECA)";

    double fates_cnp_eca_decompmicc(fates_pft=12);
      :units = "gC/m3";
      :long_name = "maximum soil microbial decomposer biomass found over depth (will be applied at a reference depth w/ exponential attenuation) (ECA)";

    double fates_cnp_eca_km_nh4(fates_pft=12);
      :units = "gN/m3";
      :long_name = "half-saturation constant for plant nh4 uptake (ECA)";

    double fates_cnp_eca_km_no3(fates_pft=12);
      :units = "gN/m3";
      :long_name = "half-saturation constant for plant no3 uptake (ECA)";

    double fates_cnp_eca_km_p(fates_pft=12);
      :units = "gP/m3";
      :long_name = "half-saturation constant for plant p uptake (ECA)";

    double fates_cnp_eca_km_ptase(fates_pft=12);
      :units = "gP/m3";
      :long_name = "half-saturation constant for biochemical P (ECA)";

    double fates_cnp_eca_lambda_ptase(fates_pft=12);
      :units = "g/m3";
      :long_name = "critical value for biochemical production (ECA)";

    double fates_cnp_eca_vmax_ptase(fates_pft=12);
      :units = "gP/m2/s";
      :long_name = "maximum production rate for biochemical P (per m2) (ECA)";

    double fates_cnp_nfix1(fates_pft=12);
      :units = "fraction";
      :long_name = "fractional surcharge added to maintenance respiration that drives symbiotic fixation";

    double fates_cnp_nitr_store_ratio(fates_pft=12);
      :units = "(gN/gN)";
      :long_name = "storeable (labile) N, as a ratio compared to the N bound in cell structures of other organs (see code)";

    double fates_cnp_phos_store_ratio(fates_pft=12);
      :units = "(gP/gP)";
      :long_name = "storeable (labile) P, as a ratio compared to the P bound in cell structures of other organs (see code)";

    double fates_cnp_pid_kd(fates_pft=12);
      :units = "unknown";
      :long_name = "derivative constant of the PID controller on adaptive fine-root biomass";

    double fates_cnp_pid_ki(fates_pft=12);
      :units = "unknown";
      :long_name = "integral constant of the PID controller on adaptive fine-root biomass";

    double fates_cnp_pid_kp(fates_pft=12);
      :units = "unknown";
      :long_name = "proportional constant of the PID controller on adaptive fine-root biomass";

    double fates_cnp_prescribed_nuptake(fates_pft=12);
      :units = "fraction";
      :long_name = "Prescribed N uptake flux. 0=fully coupled simulation >0=prescribed (experimental)";

    double fates_cnp_prescribed_puptake(fates_pft=12);
      :units = "fraction";
      :long_name = "Prescribed P uptake flux. 0=fully coupled simulation, >0=prescribed (experimental)";

    double fates_cnp_store_ovrflw_frac(fates_pft=12);
      :units = "fraction";
      :long_name = "size of overflow storage (for excess C,N or P) as a fraction of storage target";

    double fates_cnp_turnover_nitr_retrans(fates_plant_organs=4, fates_pft=12);
      :units = "fraction";
      :long_name = "retranslocation (reabsorbtion) fraction of nitrogen in turnover of scenescing tissues";

    double fates_cnp_turnover_phos_retrans(fates_plant_organs=4, fates_pft=12);
      :units = "fraction";
      :long_name = "retranslocation (reabsorbtion) fraction of phosphorus in turnover of scenescing tissues";

    double fates_cnp_vmax_nh4(fates_pft=12);
      :units = "gN/gC/s";
      :long_name = "maximum (potential) uptake rate of NH4 per gC of fineroot biomass (see main/EDPftvarcon.F90 vmax_nh4 for usage)";

    double fates_cnp_vmax_no3(fates_pft=12);
      :units = "gN/gC/s";
      :long_name = "maximum (potential) uptake rate of NO3 per gC of fineroot biomass (see main/EDPftvarcon.F90 vmax_no3 for usage)";

    double fates_cnp_vmax_p(fates_pft=12);
      :units = "gP/gC/s";
      :long_name = "maximum production rate for phosphorus (ECA and RD)";

    double fates_damage_frac(fates_pft=12);
      :units = "fraction";
      :long_name = "fraction of cohort damaged in each damage event (event frequency specified in the is_it_damage_time subroutine)";

    double fates_damage_mort_p1(fates_pft=12);
      :units = "fraction";
      :long_name = "inflection point of damage mortality function, a value of 0.8 means 50% mortality with 80% loss of crown, turn off with a large number";

    double fates_damage_mort_p2(fates_pft=12);
      :units = "unitless";
      :long_name = "rate of mortality increase with damage";

    double fates_damage_recovery_scalar(fates_pft=12);
      :units = "unitless";
      :long_name = "fraction of the cohort that recovers from damage";

    double fates_dev_arbitrary_pft(fates_pft=12);
      :units = "unknown";
      :long_name = "Unassociated pft dimensioned free parameter that developers can use for testing arbitrary new hypotheses";

    double fates_fire_alpha_SH(fates_pft=12);
