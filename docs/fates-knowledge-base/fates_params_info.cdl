    double fates_rad_model;
      :units = "unitless";
      :long_name = "switch designating the model for canopy radiation, 1 = Norman, 2 = Two-stream (experimental)";

    double fates_regeneration_model;
      :units = "-";
      :long_name = "switch for choosing between FATES\'s: 1) default regeneration scheme , 2) the Tree Recruitment Scheme (Hanbury-Brown et al., 2022), or (3) the Tree Recruitment Scheme without seedling dynamics";

    double fates_soil_salinity;
      :units = "ppt";
      :long_name = "soil salinity used for model when not coupled to dynamic soil salinity";

    double fates_trs_seedling2sap_par_timescale;
      :units = "days";
      :long_name = "Length of the window for the exponential moving average of par at the seedling layer used to calculate seedling to sapling transition rates";

    double fates_trs_seedling_emerg_h2o_timescale;
      :units = "days";
      :long_name = "Length of the window for the exponential moving average of smp used to calculate seedling emergence";

    double fates_trs_seedling_mdd_timescale;
      :units = "days";
      :long_name = "Length of the window for the exponential moving average of moisture deficit days used to calculate seedling mortality";

    double fates_trs_seedling_mort_par_timescale;
      :units = "days";
      :long_name = "Length of the window for the exponential moving average of par at the seedling layer used to calculate seedling mortality";

    double fates_vai_top_bin_width;
      :units = "m2/m2";
      :long_name = "width in VAI units of uppermost leaf+stem layer scattering element in each canopy layer";

    double fates_vai_width_increase_factor;
      :units = "unitless";
      :long_name = "factor by which each leaf+stem scattering element increases in VAI width (1 = uniform spacing)";

